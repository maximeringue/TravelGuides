@page "/guides/{Id:int}"
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using Test_HWS.ViewModels
@inject IHttpClientFactory ClientFactory

<PageTitle>@(guide?.Title ?? "Détail du guide")</PageTitle>

<a href="/" class="btn btn-outline-secondary mb-3">
    Retour aux guides
</a>

@if (isLoading)
{
    <p role="status">Chargement du guide…</p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>

    <button class="btn btn-primary" @onclick="LoadGuideAsync">
        Réessayer
    </button>
}
else if (guide is null)
{
    <div class="alert alert-warning">
        Ce guide est introuvable.
    </div>
}
else
{
    <h1>@guide.Title</h1>
    <p>@guide.Description</p>

    <dl class="row">
        <dt class="col-sm-3">Durée</dt>
        <dd class="col-sm-9">@guide.NumberOfDays jours</dd>

        <dt class="col-sm-3">Mobilité</dt>
        <dd class="col-sm-9">@guide.Mobility</dd>

        <dt class="col-sm-3">Saison</dt>
        <dd class="col-sm-9">@guide.Season</dd>

        <dt class="col-sm-3">Public</dt>
        <dd class="col-sm-9">@guide.Audience</dd>
    </dl>

    @for (var day = 1; day <= guide.NumberOfDays; day++)
    {
        var currentDay = day;

        var dayActivities = guide.Activities
            .Where(a => a.Day == currentDay)
            .OrderBy(a => a.VisitOrder)
            .ToList();

        <section class="mb-4">
            <h2 class="h4">Jour @currentDay</h2>

            @if (dayActivities.Count == 0)
            {
                <p>Aucune activité prévue pour ce jour.</p>
            }

            @foreach (var activity in dayActivities)
            {
                <article class="card mb-3">
                    <div class="card-body">
                        <h3 class="h5">@activity.Title</h3>
                        <p>@activity.Description</p>

                        <dl class="row mb-0">
                            <dt class="col-sm-3">Catégorie</dt>
                            <dd class="col-sm-9">@Display(activity.Category)</dd>

                            <dt class="col-sm-3">Adresse</dt>
                            <dd class="col-sm-9">@Display(activity.Address)</dd>

                            <dt class="col-sm-3">Téléphone</dt>
                            <dd class="col-sm-9">@Display(activity.Phone)</dd>

                            <dt class="col-sm-3">Horaires</dt>
                            <dd class="col-sm-9">@Display(activity.OpeningHours)</dd>

                            <dt class="col-sm-3">Site internet</dt>
                            <dd class="col-sm-9">
                                @if (IsWebsiteValid(activity.Website))
                                {
                                    <a href="@activity.Website"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Consulter le site
                                    </a>
                                }
                                else
                                {
                                    <span>Non renseigné</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </article>
            }
        </section>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private GuideDetailsViewModel? guide;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadGuideAsync();
    }

    private async Task LoadGuideAsync()
    {
        isLoading = true;
        errorMessage = null;
        guide = null;

        try
        {
            using var client = ClientFactory.CreateClient("TravelGuidesApi");
            using var response = await client.GetAsync($"api/guides/{Id}");

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                return;
            }

            response.EnsureSuccessStatusCode();

            guide = await response.Content
                .ReadFromJsonAsync<GuideDetailsViewModel>();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de charger ce guide. Vérifiez que l’API est démarrée.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "L’API met trop de temps à répondre.";
        }
        catch (JsonException)
        {
            errorMessage = "La réponse de l’API n’a pas le format attendu.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Non renseigné"
            : value;
    }

    private static bool IsWebsiteValid(string? value)
    {
        return Uri.TryCreate(value, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttps
                || uri.Scheme == Uri.UriSchemeHttp);
    }
}