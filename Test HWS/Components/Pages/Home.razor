@page "/"
@using System.Net.Http.Json
@using System.Text.Json
@using Test_HWS.ViewModels
@inject IHttpClientFactory ClientFactory

<PageTitle>Guides de voyage</PageTitle>

<h1>Guides de voyage</h1>
<p>Découvrez les itinéraires et activités de votre prochain voyage.</p>

@if (isLoading)
{
    <p role="status">Chargement des guides…</p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>

    <button class="btn btn-primary" @onclick="LoadGuidesAsync">
        Réessayer
    </button>
}
else if (guides.Count == 0)
{
    <p>Aucun guide disponible.</p>
}
else
{
    <div class="row g-3">
        @foreach (var guide in guides)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <article class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">@guide.Title</h2>
                        <p class="card-text">@guide.Description</p>

                        <span class="badge bg-primary">
                            @guide.NumberOfDays jours
                        </span>

                        <div class="mt-3">
                            <a class="btn btn-outline-primary"
                               href="@($"/guides/{guide.Id}")">
                                Voir le guide
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

@code {
    private List<GuideSummaryViewModel> guides = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadGuidesAsync();
    }

    private async Task LoadGuidesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            using var client = ClientFactory.CreateClient("TravelGuidesApi");

            guides = await client
                .GetFromJsonAsync<List<GuideSummaryViewModel>>("api/guides")
                ?? [];
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de charger les guides. Vérifiez que l’API est démarrée.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "L’API met trop de temps à répondre.";
        }
        catch (JsonException)
        {
            errorMessage = "La réponse de l’API n’a pas le format attendu.";
        }
        finally
        {
            isLoading = false;
        }
    }
}